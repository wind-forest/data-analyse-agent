# 复制为 .env 后填写真实值，.env 不允许提交到版本库
POSTGRES_DB=data_agent
POSTGRES_USER=data_agent
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://data_agent:CHANGE_ME@postgres:5432/data_agent
REDIS_URL=redis://redis:6379/0

# 实际调用 DeepSeek 的 OpenAI 兼容接口
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
ALLOWED_MODELS=deepseek-chat

DATA_DIR=/data
# 生产部署必须是宿主机绝对路径（Linux 示例 /srv/data-analyse-agent/data），供沙箱兄弟容器挂载
# backend 以非 root（uid 10001）运行，请确保该宿主机目录可被 uid 10001 写入
HOST_DATA_DIR=
SANDBOX_IMAGE=data-agent-sandbox:latest
# backend 需要访问 /var/run/docker.sock，生产环境填写宿主机 docker 组 GID（getent group docker）
# Docker Desktop 的 socket 为 root:root，Compose 已额外加入组 0
DOCKER_GID=999
# 沙箱镜像 pip 源；国内网络建议改为 https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple

# 认证与匿名用户限额
AUTH_ENABLED=true
# 生产环境务必替换为随机长字符串（例如 openssl rand -hex 32）
AUTH_SECRET_KEY=change-me-in-production-please-use-a-random-string
AUTH_SESSION_COOKIE=data_agent_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_CAPTCHA_TTL_SECONDS=300
ANON_MAX_SESSIONS=2
ANON_MAX_MESSAGES_PER_SESSION=3

MAX_UPLOAD_SIZE_MB=2048
ANALYSIS_TIMEZONE=Asia/Shanghai

MAX_ITERATIONS=10
AGENT_RECURSION_LIMIT=30
SIMPLE_QUERY_TIMEOUT_SECONDS=30
MODELING_TIMEOUT_SECONDS=120
AGENT_TOKEN_BUDGET=32768

SSE_EVENT_TTL_SECONDS=86400
SSE_HEARTBEAT_SECONDS=15

APPROVAL_TIMEOUT_SECONDS=300
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY=512m

# 生产前端对外监听地址与端口，默认仅本机 127.0.0.1:18080，由服务器现有 Nginx/网关转发
APP_HTTP_PORT=18080
APP_BIND_ADDRESS=127.0.0.1
# 仅开发 Compose 使用；生产 backend 不映射主机端口
BACKEND_PORT=8000
LOG_LEVEL=INFO
